APP_NAME="Car Rental API"
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=car_rental
MYSQL_USER=car_rental_app
MYSQL_PASSWORD=replace-with-your-mysql-password
JWT_SECRET_KEY=replace-with-output-of-secrets.token_hex(32)
JWT_ALGORITHM=HS256
JWT_ISSUER=car-rental-api
JWT_AUDIENCE=car-rental-client
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS='["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]'
GOOGLE_API_KEY=
# Set a currently available Gemini model supporting structured JSON output.
GOOGLE_MODEL=gemini-3.8-flash
# Per-attempt deadline of one Gemini call in seconds (5-55). The SDK retries once
# on 429/500/503/504, so the worst case is about twice this value.
GOOGLE_TIMEOUT_SECONDS=20
# Gemini 3.x thinks by default. low is enough for filter/ID extraction; allowed:
# low, medium, high. Leave empty only for a model without thinking_level.
GOOGLE_THINKING_LEVEL=low
RATE_LIMIT_MAX_KEYS=10000

# console logs development messages; smtp sends real email.
EMAIL_BACKEND=console
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_USE_TLS=false
MAIL_FROM=bookings@rental.local

# Local development only. `python -m src.seed` refuses to run when this is production.
APP_ENV=development
# Shared password of the demo users created by `python -m src.seed`. Choose your
# own (12+ characters, must not contain the e-mail name such as "anna.demo").
# Never commit a real value.
SEED_USER_PASSWORD=20112005Mk
